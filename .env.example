# 复制为 .env 后按需修改。不要将真实 .env 提交到仓库。
# 以下默认值仅供本机开发，切勿把带默认密钥的服务暴露到公网。
# 本文件可供 docker compose 与后端共用（后端也可改用 backend/.env）。

# ----- PostgreSQL -----
# 以下变量同时用于 docker compose（创建库/用户）和后端连接。
# POSTGRES_PORT 是后端连接的主机映射端口（19666），不要把它传给 postgres 容器当作服务端口；
# 容器内仍是 5432，compose 端口映射仍是 19666:5432。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=19666
POSTGRES_DB=genssl
POSTGRES_USER=genssl
POSTGRES_PASSWORD=genssl

# ----- RustFS -----
# docker compose 读取 ACCESS_KEY / SECRET_KEY / UNSAFE_BYPASS_DISK_CHECK；
# 后端同时读取 ENDPOINT / REGION / BUCKET / ACCESS_KEY / SECRET_KEY。
RUSTFS_ENDPOINT=http://127.0.0.1:19701
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=genssl
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=true

# ----- 后端应用 -----
PORT=18087
# 启动时自动同步表结构。生产环境可改为 false 并自行管理结构。
TYPEORM_SYNC=true

# ----- SSH 凭据加密 -----
# 用于加密保存在 PostgreSQL 中的 SSH 密码和私钥（AES-256-GCM）。
# 推荐 32 字节的十六进制（64 个字符）。下面是示例/开发值，生产必须换成自己的密钥。
# 不要把真实密钥提交到仓库。本地开发若未设置，后端会使用内置开发默认值（仅限非生产环境）。
# 生产环境或设置 GENSSL_STRICT_SECRETS=true 时必须配置，否则测试连接和上传部署会失败。
GENSSL_SSH_CREDENTIAL_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GENSSL_STRICT_SECRETS=false
