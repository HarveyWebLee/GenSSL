# 复制为 .env.production 后按需修改。不要将真实 .env.production 提交到仓库，也不要打进镜像。
# 配合生产编排使用：
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#   若没有 Compose 插件、只有独立命令，改用：
#   docker-compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# 键名与本地开发（.env.example）对齐，但主机和端口按容器网络填写。
# 生产必须自行更换密码和密钥；下面只是占位符。

# ----- PostgreSQL -----
# 后端容器应连接服务名 postgres、容器内端口 5432（不要用开发环境的 127.0.0.1:19666）。
# docker-compose.prod.yml 已为后端写死 POSTGRES_HOST / POSTGRES_PORT，避免误用开发地址。
# 下面三项会同时提供给 postgres 容器和后端。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=genssl
POSTGRES_USER=genssl
POSTGRES_PASSWORD=change-me-postgres-password

# ----- RustFS -----
# 后端容器应连接 http://rustfs:9000（不要用开发环境的 127.0.0.1:19701）。
# docker-compose.prod.yml 已为后端写死 RUSTFS_ENDPOINT。
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=genssl
RUSTFS_ACCESS_KEY=change-me-rustfs-access-key
RUSTFS_SECRET_KEY=change-me-rustfs-secret-key
# 单机部署可用。不要把 RustFS 暴露到公网。
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=true

# ----- 数据目录（宿主机绑定挂载） -----
# 相对路径相对于 docker-compose.prod.yml 所在的项目根目录。
# 也可改成绝对路径；Windows 请使用正斜杠，例如 D:/genssl-data/postgres。
# 不要留空：compose 在变量为空时会回退到下面这些默认值，以免误挂到 /0 等根路径。
# 若之前已经用 Docker 命名卷跑过生产栈，改成绑定挂载后不会自动迁移旧数据。
POSTGRES_DATA_PATH=./data/prod/postgres
# RustFS 四个数据目录共用一个父目录，容器内仍分别挂到 /data/rustfs0–3（对应父目录下的 0/1/2/3）。
RUSTFS_DATA_PATH=./data/prod/rustfs
RUSTFS_LOGS_PATH=./data/prod/rustfs-logs

# ----- 后端应用 -----
# 生产发布端口 19347。compose 已为后端容器写死 PORT / HOST，须与前端 Nginx 反代一致。
PORT=19347
# 启动时自动同步表结构。稳定后可改为 false 并自行管理结构。
TYPEORM_SYNC=true

# ----- SSH 凭据加密 -----
# 用于加密保存在 PostgreSQL 中的 SSH 密码和私钥（AES-256-GCM）。
# 生产环境必须配置，并自行更换下面的占位符。推荐 32 字节十六进制（64 个字符）：
#   openssl rand -hex 32
# 设置 GENSSL_STRICT_SECRETS=true 时，缺少该密钥会导致测试连接和上传部署失败。
GENSSL_SSH_CREDENTIAL_KEY=replace-with-your-own-64-char-hex-key
GENSSL_STRICT_SECRETS=true
